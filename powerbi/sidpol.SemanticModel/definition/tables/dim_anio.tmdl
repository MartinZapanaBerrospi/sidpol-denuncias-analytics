/// Año de la población. Se une a los hechos de población; la tasa lo alcanza con TREATAS.
table dim_anio
	lineageTag: 12b5f0c4-34c4-5e69-a829-e5289e479348

	column anio
		dataType: int64
		isKey
		formatString: 0
		lineageTag: 52c58630-09e6-5378-a560-4cafad103543
		summarizeBy: none
		sourceColumn: anio

		annotation SummarizationSetBy = Automatic

	/// Año completo o enero–julio
	column periodo
		dataType: string
		lineageTag: 7ac2aa62-c55c-541c-9fd0-0572ca7cdb54
		summarizeBy: none
		sourceColumn: periodo

		annotation SummarizationSetBy = Automatic

	partition dim_anio = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "dim_anio.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"anio", Int64.Type}, {"periodo", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
